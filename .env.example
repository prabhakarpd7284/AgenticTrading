# Copy to .env (never commit). Read by docker-compose.prod.yml on the EC2 host.

POSTGRES_USER=alphadesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alphadesk

DATABASE_URL=postgres://alphadesk:change-me@postgres:5432/alphadesk
REDIS_URL=redis://redis:6379/0

DJANGO_SECRET_KEY=change-me
ANTHROPIC_API_KEY=
ALLOWED_HOSTS=alphadesk.example.com
CORS_ALLOWED_ORIGINS=https://alphadesk.example.com

# ECR image URIs — stamped by the deploy workflow with the current git SHA
BACKEND_IMAGE=<acct>.dkr.ecr.ap-south-1.amazonaws.com/alphadesk/backend:latest
WORKER_IMAGE=<acct>.dkr.ecr.ap-south-1.amazonaws.com/alphadesk/worker:latest
FRONTEND_IMAGE=<acct>.dkr.ecr.ap-south-1.amazonaws.com/alphadesk/frontend:latest
