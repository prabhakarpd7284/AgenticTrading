# ── Python ──
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
pytest-cache-files-*

# ── Virtual environments ──
.venv
backend/.venv

# ── Secrets — NEVER commit ──
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Local data / runtime ──
db.sqlite3
db.sqlite3.bak*
*.bak
logs/
NSE_CM_sym_master.json
*.jsonl

# ── Frontend ──
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
# Stray .js emit inside src/ (running tsc without noEmit:true would shadow
# .tsx sources at Vite resolution time — see CLAUDE.md frontend note).
# Sources are .ts/.tsx only.
frontend/src/**/*.js

# ── Infra (local terraform state, etc.) ──
infra/*

# ── Editor / OS ──
.DS_Store
.vscode/
.idea/

# Runtime / log artifacts (not source)
backend/celerybeat-schedule.db
celerybeat-schedule*
*.log
backend/fyersApi.log
backend/fyersRequests.log
