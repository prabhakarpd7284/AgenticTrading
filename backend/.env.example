DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# docker-compose.dev.yml exposes Postgres on host port 5444 (the container
# still listens on 5432 internally — only the host mapping is 5444).
DATABASE_URL=postgres://alphadesk:alphadesk@localhost:5444/alphadesk
# Redis is on :6380 (docker maps 6380:6379). :6379 on this host is a SEPARATE
# project — do NOT point AlphaDesk at it or the shared throttle/breaker break.
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

TRADING_MODE=paper

# Zerodha Kite Connect app (developers.kite.trade — free Personal plan).
# Read by `manage.py zerodha_login`, which mints the daily access_token
# (expires ~6 AM IST) and saves it on the tenant's Zerodha BrokerLink.
KITE_API_KEY=
KITE_API_SECRET=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# SmartAPI rate limiting (min gap in seconds between calls; cross-process via
# Redis). getCandleData is Angel's tight endpoint (~3/s) so it gets a wider
# gap — widen these if you still see "exceeding access rate" / breaker trips.
SMARTAPI_MIN_INTERVAL=0.4
SMARTAPI_CANDLE_MIN_INTERVAL=0.7

DEFAULT_CAPITAL=500000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_POSITION_SIZE_PCT=10.0

SENTRY_DSN=
SENTRY_ENV=dev

# Set to 1 so Channels uses the Redis layer instead of the in-memory one.
# Required whenever a producer (Celery worker) and the websocket consumers
# (Daphne) live in different processes — e.g. the live tick feed.
USE_REDIS=1

# Fyers app (fyers.in/web/api-dashboard/user-apps) for `manage.py fyers_login`.
# Register redirect URL https://trade.fyers.in/api-login/redirect-uri/index.html
FYERS_APP_ID=
FYERS_SECRET_KEY=
